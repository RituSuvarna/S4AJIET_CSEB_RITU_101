public class ReverseNumber {
    public static void main(String[] args) {
        int num = 1528;
        int reverse = 0;

        System.out.println("Original number: " + num);

        while (num > 0) {
            int digit = num % 10;
            reverse = reverse * 10 + digit;
            num = num / 10;
        }

        System.out.println("Reversed number: " + reverse);
    }
}
