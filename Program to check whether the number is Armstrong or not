public class Armstrong {
    public static void main(String[] args) {
        int num = 153; 
        int a = num;
        int sum = 0;

        while (a > 0) {
            int digit = a % 10;
            sum = sum + digit * digit * digit; 
            a = a / 10;
        }

        if (sum == num) {
            System.out.println("Armstrong number");
        } else {
            System.out.println("Not an Armstrong number");
        }
    }
}
