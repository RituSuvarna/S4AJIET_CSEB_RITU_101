class Swapping{
    public static void main(String[] args) {
        int p=30;
        int q=20;
    
     System.out.println("Before Swapping");
     System.out.println("P :"+p);
     System.out.println("Q :"+q);   
     
        p=p+q;
        q=p-q;
        p=p-q;
        
     System.out.println("After Swapping");
     System.out.println("P :"+p);
     System.out.println("Q :"+q);   
    }
}
